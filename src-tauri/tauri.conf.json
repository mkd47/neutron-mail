{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Neutron Mail",
  "version": "0.4.0",
  "identifier": "dev.neutronmail.NeutronMail",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Neutron Mail",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "create": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "frame-src": "'self' http: https: mailto:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm"
    ],
    "category": "Productivity",
    "shortDescription": "Native IMAP/SMTP mail client (prototype)",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "neutron-mail.desktop",
        "depends": [
          "libssl3t64 | libssl3",
          "libdbus-1-3"
        ]
      },
      "rpm": {
        "desktopTemplate": "neutron-mail.desktop",
        "depends": [
          "openssl-libs",
          "dbus-libs"
        ]
      }
    }
  }
}
