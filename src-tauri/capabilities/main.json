{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Least privilege: the main window may call only Neutron's own commands, listen for its events, and open http(s) links in the default browser (opener scoped to http/https; mailto is handled in-app). No fs, shell, http or dialog permissions are granted to the webview: native file dialogs are driven from Rust.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-app-info",
    "allow-list-accounts",
    "allow-add-account",
    "allow-list-providers",
    "allow-detect-provider",
    "allow-autoconfig-lookup",
    "allow-oauth-sign-in",
    "allow-oauth-configured",
    "allow-remove-account",
    "allow-set-password",
    "allow-sync-account",
    "allow-list-folders",
    "allow-list-messages",
    "allow-list-threads",
    "allow-conversation",
    "allow-get-message",
    "allow-set-image-sender-trust",
    "allow-update-account",
    "allow-get-account-settings",
    "allow-set-account-settings",
    "allow-list-image-senders",
    "allow-new-draft",
    "allow-message-source",
    "allow-search",
    "allow-compose-prefill",
    "allow-send-message",
    "allow-discard-draft",
    "allow-queue-send",
    "allow-check-update",
    "allow-open-release-page",
    "allow-save-eml",
    "allow-import-messages",
    "allow-schedule-send",
    "allow-list-scheduled",
    "allow-send-scheduled-now",
    "allow-reschedule",
    "allow-cancel-scheduled",
    "allow-list-templates",
    "allow-save-template",
    "allow-delete-template",
    "allow-get-auto-reply",
    "allow-auto-reply-server-support",
    "allow-set-auto-reply",
    "allow-cancel-send",
    "allow-send-now",
    "allow-save-draft",
    "allow-analyze-link",
    "allow-pick-attachments",
    "allow-save-attachment",
    "allow-save-all-attachments",
    "allow-open-attachment",
    "allow-suggest-contacts",
    "allow-sanitize-compose-html",
    "allow-contacts-status",
    "allow-address-info",
    "allow-add-contact",
    "allow-upcoming-events",
    "allow-set-unread-badge",
    "allow-get-invite",
    "allow-respond-invite",
    "allow-create-folder",
    "allow-rename-folder",
    "allow-delete-folder",
    "allow-set-folder-subscribed",
    "allow-move-messages",
    "allow-undo-transfer",
    "allow-set-message-flag",
    "allow-delete-messages",
    "allow-print-message",
    "allow-list-rules",
    "allow-save-rules",
    "allow-test-rule",
    "allow-run-rules-now",
    "allow-sieve-status",
    "allow-sieve-upload",
    "allow-sieve-disable",
    "allow-note-folders",
    "allow-create-note-folder",
    "allow-rename-note-folder",
    "allow-delete-note-folder",
    "allow-note-tags",
    "allow-list-notes",
    "allow-get-note",
    "allow-save-note",
    "allow-delete-note",
    "allow-note-from-message",
    "allow-link-note-email",
    "allow-unlink-note-email",
    "allow-email-link",
    "allow-resolve-email-link",
    "allow-task-lists",
    "allow-create-task-list",
    "allow-rename-task-list",
    "allow-delete-task-list",
    "allow-list-tasks",
    "allow-task-counts",
    "allow-save-task",
    "allow-set-task-completed",
    "allow-delete-task",
    "allow-flagged-emails",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        }
      ]
    }
  ]
}
